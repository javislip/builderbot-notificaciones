# Puerto para el bot y el servidor HTTP
PORT=3008

# Zona horaria para el servidor (ej. America/Caracas, Europe/Madrid, UTC, etc.)
TZ=America/Caracas

# Clave API secreta para proteger el endpoint POST /v1/messages
# Cualquier cliente que envíe mensajes debe proveer esta clave en la cabecera x-api-key o Authorization: Bearer
API_KEY=your_secret_api_key_here
